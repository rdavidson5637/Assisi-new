# Copy to .env.local and fill in when the accounts are ready.
# The site stays honest without these: donations offer phone and email,
# and enquiry forms offer an email draft instead of a fake confirmation.

# Stripe secret key (sk_live_... or sk_test_...). Enables card checkout.
STRIPE_SECRET_KEY=

# Formspree form id (the part after https://formspree.io/f/).
# One form receives contact, adoption, volunteer, newsletter, sponsorship and membership.
FORMSPREE_FORM_ID=

# Public site URL used in metadata. Checkout only redirects back to this
# URL, the live site, a Vercel deployment host, or localhost.
NEXT_PUBLIC_SITE_URL=https://www.assisi-ni.org
